<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Firebase emulator access (design §9.3), debug builds only.
    - Android 17 (API 37) blocks private-network addresses such as 10.0.2.2 without this runtime
      permission. Grant it with `adb install -g` instead of asking in the UI.
    - The emulators speak plain HTTP; network_security_config allows it to 10.0.2.2 only.
  -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
  <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
