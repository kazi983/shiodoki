{
  "name": "shiodoki",
  "productName": "Shiodoki",
  "version": "2.0.0-alpha.2",
  "description": "Desktop app that asks what to work on every 30 minutes and tracks time per task",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev -- --ozone-platform=x11",
    "dev:test": "cross-env TASK_MODE=test electron-vite dev -- --ozone-platform=x11",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --ozone-platform=x11",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "e2e": "electron-vite build && node e2e/smoke.mjs",
    "e2e:headless": "electron-vite build && xvfb-run -a -s \"-screen 0 1920x1080x24\" node e2e/smoke.mjs && ../firebase/node_modules/.bin/firebase emulators:exec --config ../firebase/firebase.json --only auth,firestore --project demo-shiodoki \"xvfb-run -a -s '-screen 0 1920x1080x24' node e2e/firebase.mjs\"",
    "test:integration": "../firebase/node_modules/.bin/firebase emulators:exec --config ../firebase/firebase.json --only auth,firestore --project demo-shiodoki \"vitest run --config vitest.integration.config.ts\"",
    "e2e:firebase": "electron-vite build && ../firebase/node_modules/.bin/firebase emulators:exec --config ../firebase/firebase.json --only auth,firestore --project demo-shiodoki \"node e2e/firebase.mjs\"",
    "dev:local": "cross-env TIMER_LOCAL=1 electron-vite dev -- --ozone-platform=x11",
    "setup:linux-sandbox": "bash scripts/setup-linux-sandbox.sh"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "firebase": "^12.19.0",
    "playwright": "1.63",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "io.github.kazi983.shiodoki",
    "productName": "Shiodoki",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kazi983/shiodoki.git"
  },
  "author": "Kaoru Kajihara <kaoru.kajihara.mail@gmail.com>"
}
