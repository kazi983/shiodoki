{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "vitest.integration.config.ts", "tests-integration/**/*", "src/renderer/data/firestoreStore.ts", "src/renderer/data/mapping.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "tests/**/*", "e2e/**/*"]
}
