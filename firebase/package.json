{
  "name": "shiodoki-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "node scripts/firebase.mjs emulators:start --project demo-shiodoki",
    "test": "node scripts/firebase.mjs emulators:exec --only firestore --project demo-shiodoki \"vitest run\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.32.1",
    "vitest": "^5.0.3"
  }
}
